#include "../Build.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(MAIN_BUNDLE_IDENTIFIER)

// for ios14 and above swift runtime is included
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = NO

// SideStore shell: C decompressors (zstd, bzip2) used to read tweak packages (.deb)
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/SideStore/Core/Tweaks/Decompress/SideStore-Decompress-Bridging-Header.h

#include? "../local.xcconfig"
